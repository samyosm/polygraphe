# Copy to .env and adjust. Every variable is prefixed with POLYGRAPHE_.

# Shared secret the device must present to open a websocket.
POLYGRAPHE_DEVICE_TOKEN=change-me

# Password of operator mode (create, edit, start, stop trials). Watching needs none.
POLYGRAPHE_OPERATOR_PASSWORD=dummy
POLYGRAPHE_OPERATOR_SESSION_HOURS=12
# Signs operator sessions. Leave unset for a random one: sessions then end at each restart.
# POLYGRAPHE_SECRET_KEY=

# "database" for real storage (InfluxDB for measurements, SQLite for trials),
# "memory" to run without any database (tests, quick demos).
POLYGRAPHE_STORAGE_BACKEND=database
POLYGRAPHE_DATABASE_URL=sqlite+aiosqlite:///./polygraphe.db

POLYGRAPHE_INFLUX_URL=http://localhost:8086
POLYGRAPHE_INFLUX_TOKEN=polygraphe-dev-token
POLYGRAPHE_INFLUX_ORG=polygraphe
POLYGRAPHE_INFLUX_RAW_BUCKET=raw
POLYGRAPHE_INFLUX_PROCESSED_BUCKET=processed

# Fake device that generates heart rate and SpO2 while the hardware is being built.
POLYGRAPHE_DUMMY_ENABLED=true
POLYGRAPHE_DUMMY_DEVICE_ID=dummy-1
