# Deployment settings, read by docker-compose.yml. Copy to .env and fill in.
# Generate secrets with:  openssl rand -hex 32

# Public domain name (NGINX serves it; the interface talks to https://<DOMAIN>/api).
DOMAIN=polygraphe.samy.dev

# Password of operator mode: create, edit, start, stop and save trials. Watching needs none.
OPERATOR_PASSWORD=dummy
# How long operator mode stays unlocked, in hours.
OPERATOR_SESSION_HOURS=12
# Signs operator sessions. Changing it signs every operator out.
SECRET_KEY=

# Shared secret the device sends to stream data (?token=... on its websocket).
DEVICE_TOKEN=

# InfluxDB: admin UI password (not exposed publicly) and API token used by the backend.
INFLUX_ADMIN_PASSWORD=
INFLUX_TOKEN=

# Simulated device "dummy-1" (heart rate + SpO2). Set to false once the real device is in use.
DUMMY_ENABLED=true

# Local ports NGINX proxies to (bound to 127.0.0.1 only). Change them if they are taken.
FRONTEND_PORT=3000
BACKEND_PORT=8000
